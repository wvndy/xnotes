<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: solid blue matching Xnotes splash -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/xnotes_primary"
                android:endColor="@color/xnotes_primary_dark"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
